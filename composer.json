{
  "name": "curib123/pk-document-tracking-system",
  "description": "Unstyled, modal-operated CodeIgniter 3 document control system",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "codeigniter/framework": "3.1.13",
    "setasign/fpdi": "^2.6",
    "setasign/fpdf": "^1.8"
  },
  "autoload": { "psr-4": { "Pk\\": "application/src/" } },
  "scripts": { "test": "php tests/run.php", "test:integration": "php tests/integration.php" },
  "config": { "allow-plugins": false, "sort-packages": true }
}
