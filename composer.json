{
  "name": "curib123/pk-document-tracking-system",
  "description": "PK DCS (Document Control System) original schema CodeIgniter 3 master-based MVC rebuild",
  "type": "project",
  "require": {
    "php": "^8.0",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "codeigniter/framework": "3.1.13",
    "setasign/fpdi": "^2.6",
    "setasign/fpdf": "^1.8",
    "ext-mysqli": "*"
  },
  "scripts": {
    "test": [
      "@php tools/tests/offline_assets.php",
      "@php tools/tests/scanned_policy.php",
      "@php tools/tests/scanned_category_policy.php",
      "@php tools/tests/signatory_references.php",
      "@php tools/tests/softcopy_document_number_generator.php",
      "@php tools/tests/workflow_document_lock.php",
      "@php tools/tests/workflow_final_file_step.php",
      "@php tools/tests/backup_rotation.php",
      "@php tools/tests/orphan_file_cleanup.php",
      "@php tools/tests/scanned_integration.php"
    ]
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
