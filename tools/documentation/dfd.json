{
  "title": "PK DTS - Data Flow Diagram",
  "pages": [
    {
      "id": "context-all-roles",
      "kind": "context",
      "title": "PK DTS and its users",
      "summary": "The five supplied roles and the information each sends and receives.",
      "actors": [
        {"role": "Staff", "responsibility": "Requester, holder or named receiving user", "sends": "Searches; requests; receipt", "receives": "Records; status; tasks"},
        {"role": "Document Control Officer", "responsibility": "Controls documents; reviews assigned requests", "sends": "Record changes; decisions", "receives": "Documents; review tasks"},
        {"role": "Plant Manager", "responsibility": "Reviews assigned requests; may also request", "sends": "Decisions; requests", "receives": "Proposals; records; status"},
        {"role": "Administrator", "responsibility": "Manages accounts, setup and recovery", "sends": "Setup; recovery choices", "receives": "Results; records; archives"},
        {"role": "Internal Auditor", "responsibility": "Reviews permitted records and audit evidence", "sends": "Searches; audit filters", "receives": "Records; history; audit"}
      ],
      "note": "Five supplied roles checked 5 Nov 2026; custom roles allowed. Requester, requester's leader and receiving user are responsibilities, not extra roles."
    },
    {
      "id": "overview",
      "title": "Main information flows",
      "summary": "People send information, PK DTS processes it, and business records hold the result.",
      "flows": [
        {"from": "User", "from_kind": "actor", "input": "Credentials and search terms", "process": "1. Sign in and find records", "output": "Sign-in result; permitted records", "to": "User", "to_kind": "actor"},
        {"from": "Document controller", "from_kind": "actor", "input": "Document details and files", "process": "2-4. Maintain document records", "output": "Saved documents and changes", "to": "Document registers", "to_kind": "store"},
        {"from": "Request participants", "from_kind": "actor", "input": "Proposal, file and decisions", "process": "5. Review document requests", "output": "Request progress and decisions", "to": "Request records", "to_kind": "store"},
        {"from": "Document user", "from_kind": "actor", "input": "Handoff, access or disposal details", "process": "6-8. Manage custody and use", "output": "Custody, access or disposal result", "to": "Document tracking records", "to_kind": "store"},
        {"from": "Authorized maintainer", "from_kind": "actor", "input": "Setup and recovery choices", "process": "9-11. Maintain system operations", "output": "Settings, notices, audit and backups", "to": "System operating records", "to_kind": "store"}
      ],
      "note": "People and activities use boxes; stored business records use open-ended boxes. Arrows name the information exchanged."
    },
    {
      "id": "hardcopy-tracking",
      "title": "2. Hardcopy records and storage",
      "summary": "Hardcopy creation and editing are direct actions; new creation and update requests are unavailable.",
      "flows": [
        {"from": "Hardcopy record editor", "from_kind": "actor", "input": "Title, holder and storage", "process": "2.1 Register or edit hardcopy", "output": "Record and change history", "to": "Hardcopy register", "to_kind": "store"},
        {"from": "Reference records", "from_kind": "store", "input": "Active storage path and holder", "process": "2.1 Check record details", "output": "Save result or required correction", "to": "Hardcopy record editor", "to_kind": "actor"},
        {"from": "Hardcopy register", "from_kind": "store", "input": "Holder, storage and status", "process": "2.2 View hardcopy details", "output": "Custody and storage details", "to": "Authorized document user", "to_kind": "actor"},
        {"from": "Hardcopy register", "from_kind": "store", "input": "Retention start and end dates", "process": "2.3 View retention status", "output": "Days remaining; due; overdue", "to": "Authorized record reviewer", "to_kind": "actor"},
        {"from": "Handoff records", "from_kind": "store", "input": "Approved move and receipt history", "process": "2.2 View tracking history", "output": "Release and receipt details", "to": "Authorized reviewer", "to_kind": "actor"}
      ],
      "note": "Storage: Area > Specific > optional Asset > Location. Retention dates prompt review and never trigger disposal."
    },
    {
      "id": "softcopy-files",
      "title": "3. Softcopy records and files",
      "summary": "Direct changes publish immediately; proposals publish after final approval. Cancellation requests are unavailable.",
      "flows": [
        {"from": "Document controller", "from_kind": "actor", "input": "Title, category, pages and file", "process": "3.1 Create or revise directly", "output": "Current document and file", "to": "Softcopy records", "to_kind": "store"},
        {"from": "Requester", "from_kind": "actor", "input": "Proposed details and file", "process": "5. Save and route request", "output": "Draft or submitted proposal", "to": "Request records", "to_kind": "store"},
        {"from": "Request records", "from_kind": "store", "input": "Approved creation or revision", "process": "3.2 Publish approved change", "output": "Current revision and file", "to": "Softcopy records", "to_kind": "store"},
        {"from": "Softcopy records", "from_kind": "store", "input": "Current file and user access", "process": "3.3 Check file permission", "output": "Download or print access", "to": "Authorized file user", "to_kind": "actor"},
        {"from": "Softcopy revision history", "from_kind": "store", "input": "Revision details and changes", "process": "3.4 View revision history", "output": "Available revision information", "to": "Authorized reviewer", "to_kind": "actor"}
      ],
      "note": "Creation uses Softcopy Categories and automatic numbering; series is optional. Revision keeps the document identity and advances its revision."
    },
    {
      "id": "external-documents",
      "title": "4. External documents and revisions",
      "summary": "External Documents use a separate category tree. Creation and revision can be direct or approval based.",
      "flows": [
        {"from": "Document controller", "from_kind": "actor", "input": "Title, category, description and file", "process": "4.1 Create or revise directly", "output": "Current document and revision", "to": "External document records", "to_kind": "store"},
        {"from": "Requester", "from_kind": "actor", "input": "Creation or revision proposal", "process": "5. Save and route request", "output": "Proposal and file for review", "to": "Request records", "to_kind": "store"},
        {"from": "Request records", "from_kind": "store", "input": "Approved creation or revision", "process": "4.2 Publish approved change", "output": "Current document and file", "to": "External document records", "to_kind": "store"},
        {"from": "External Categories", "from_kind": "store", "input": "Category and parent folder", "process": "4.3 Browse external folders", "output": "Permitted document list", "to": "Authorized document user", "to_kind": "actor"},
        {"from": "External document records", "from_kind": "store", "input": "Current file and user access", "process": "4.4 Check file permission", "output": "Current file download", "to": "Authorized file user", "to_kind": "actor"}
      ],
      "note": "Creation and revision require a new attachment. Revision numbers advance automatically. No retention dates; Download uses the current file."
    },
    {
      "id": "requests-approvals",
      "title": "5. Requests and approvals",
      "summary": "A published route assigns reviews in order and records decisions and proposal changes.",
      "flows": [
        {"from": "Requester", "from_kind": "actor", "input": "Draft details, file and submission", "process": "5.1 Check and submit request", "output": "Submitted request and route", "to": "Request records", "to_kind": "store"},
        {"from": "Published approval routes", "from_kind": "store", "input": "Review order and requester's leader", "process": "5.2 Assign the active review", "output": "Proposal, review task and file", "to": "Assigned approver", "to_kind": "actor"},
        {"from": "Assigned approver", "from_kind": "actor", "input": "Approve, Return or Reject; remarks", "process": "5.3 Record the decision", "output": "Decision and current stage", "to": "Request records", "to_kind": "store"},
        {"from": "Request records", "from_kind": "store", "input": "First-step Return and corrections", "process": "5.4 Show required corrections", "output": "Returned proposal to edit", "to": "Requester", "to_kind": "actor"},
        {"from": "Request records", "from_kind": "store", "input": "Final approval and request details", "process": "5.5 Apply approved action", "output": "Document change or pending handoff", "to": "Document activity records", "to_kind": "store"}
      ],
      "note": "Return at later steps reopens the prior review. Reject ends the request. Resubmission keeps the route. Opening a notice records no decision."
    },
    {
      "id": "physical-handoffs",
      "title": "6. Physical transfer and receipt",
      "summary": "Acceptance checks the document, holder and approved storage before updating custody. Approval starts handoff tracking.",
      "flows": [
        {"from": "Approved transfer request", "from_kind": "store", "input": "Holder, recipient and destination", "process": "6.1 Prepare physical handoff", "output": "For Transfer handoff", "to": "Transfer tracking records", "to_kind": "store"},
        {"from": "Original requester", "from_kind": "actor", "input": "Dispatch confirmation", "process": "6.2 Record dispatch", "output": "In Transit; dispatcher; time", "to": "Transfer tracking records", "to_kind": "store"},
        {"from": "Named receiving user", "from_kind": "actor", "input": "Accept confirmation after receipt", "process": "6.3 Check and record receipt", "output": "Accepted; receiver; time", "to": "Transfer tracking records", "to_kind": "store"},
        {"from": "Accepted transfer record", "from_kind": "store", "input": "Recipient and approved storage", "process": "6.4 Update holder and storage", "output": "New holder and location", "to": "Hardcopy records", "to_kind": "store"},
        {"from": "Transfer tracking records", "from_kind": "store", "input": "Accepted receipt and completion", "process": "6.5 View handoff result", "output": "Receipt and updated tracking", "to": "Authorized tracking viewer", "to_kind": "actor"}
      ],
      "note": "Only the original requester can Dispatch; only the named receiver can Accept. Custody changes revoke the previous holder's personal hardcopy grants."
    },
    {
      "id": "access-assignment",
      "title": "7. Access and assignment",
      "summary": "Access grants permit use. Assignment changes a softcopy assignee or hardcopy holder. Physical transfers are separate.",
      "flows": [
        {"from": "Requester", "from_kind": "actor", "input": "Personal access need and expiry", "process": "5. Review access request", "output": "Approved access request", "to": "Request records", "to_kind": "store"},
        {"from": "Approved access request", "from_kind": "store", "input": "Requester, document and expiry", "process": "7.1 Grant temporary access", "output": "Personal access until expiry", "to": "Document access records", "to_kind": "store"},
        {"from": "Approved assignment request", "from_kind": "store", "input": "Requester and selected document", "process": "7.2 Apply assignment", "output": "New assignee or holder", "to": "Document assignment records", "to_kind": "store"},
        {"from": "Assignment controller", "from_kind": "actor", "input": "Document, Location or category; user", "process": "7.3 Assign documents directly", "output": "Updated assignees or holders", "to": "Document assignment records", "to_kind": "store"},
        {"from": "Document permission records", "from_kind": "store", "input": "Current access and permissions", "process": "7.4 Show permitted documents", "output": "Permitted records and actions", "to": "Document user", "to_kind": "actor"}
      ],
      "note": "Requests are for the requester, using Hardcopy or Softcopy. Hardcopy assignment keeps storage; direct assignment checks active handoffs."
    },
    {
      "id": "disposal",
      "title": "8. Document disposal",
      "summary": "Disposal restricts document use and records its reason. Physical disposal follows the organization's procedure separately.",
      "flows": [
        {"from": "Authorized document user", "from_kind": "actor", "input": "Document and disposal reason", "process": "8.1 Dispose directly", "output": "Disposed status and history", "to": "Document registers", "to_kind": "store"},
        {"from": "Requester", "from_kind": "actor", "input": "Hardcopy or External disposal details", "process": "5. Review disposal request", "output": "Approved disposal request", "to": "Request records", "to_kind": "store"},
        {"from": "Approved disposal request", "from_kind": "store", "input": "Hardcopy and disposal method", "process": "8.2 Dispose approved hardcopy", "output": "Disposed; Location cleared", "to": "Hardcopy records", "to_kind": "store"},
        {"from": "Approved disposal request", "from_kind": "store", "input": "External document and method", "process": "8.3 Dispose approved external", "output": "Disposed status and history", "to": "External document records", "to_kind": "store"},
        {"from": "Disposal history", "from_kind": "store", "input": "Method, responsible person and date", "process": "8.4 View disposal result", "output": "Disposal details and history", "to": "Authorized reviewer", "to_kind": "actor"}
      ],
      "note": "Direct hardcopy disposal keeps its place and grant records. Requested hardcopy disposal clears Location and revokes grants."
    },
    {
      "id": "setup-roles-workflows",
      "title": "9. Accounts and system setup",
      "summary": "Maintainers manage accounts, roles, places, categories and routes. Primary and assigned active roles combine permissions.",
      "flows": [
        {"from": "Account administrator", "from_kind": "actor", "input": "Account, roles, leader or password reset", "process": "9.1 Maintain user accounts", "output": "Account and role membership", "to": "User accounts", "to_kind": "store"},
        {"from": "Role administrator", "from_kind": "actor", "input": "Role name and permitted actions", "process": "9.2 Maintain roles and permissions", "output": "Permitted actions by active role", "to": "Role permissions", "to_kind": "store"},
        {"from": "Setup maintainer", "from_kind": "actor", "input": "Places and category folders", "process": "9.3 Maintain places and categories", "output": "Storage and category structure", "to": "Reference records", "to_kind": "store"},
        {"from": "Approval-route administrator", "from_kind": "actor", "input": "Review order and approvers", "process": "9.4 Check and publish route", "output": "Default route for new requests", "to": "Published approval routes", "to_kind": "store"},
        {"from": "User accounts", "from_kind": "store", "input": "Active roles and requester's leader", "process": "9.5 Identify assigned reviewer", "output": "Account, role or leader assignment", "to": "Assigned approver", "to_kind": "actor"}
      ],
      "note": "DCO has no default user, role, workflow or backup administration. Any permitted role can carry leader or receiving-user duties."
    },
    {
      "id": "notices-audit-recovery",
      "title": "10-11. Notices, audit and recovery",
      "summary": "Notices link to work; audit records support review. Automatic backups need administrator setup and evidence of a recent run.",
      "flows": [
        {"from": "Request tracking records", "from_kind": "store", "input": "Assigned work and progress", "process": "10.1 Show task notices", "output": "Notice and link to work", "to": "Assigned user", "to_kind": "actor"},
        {"from": "Hardcopy register", "from_kind": "store", "input": "Visible hardcopy due dates", "process": "10.2 Show retention reminder", "output": "Document review reminder", "to": "Authorized document user", "to_kind": "actor"},
        {"from": "Audit records", "from_kind": "store", "input": "Actor, action, date and outcome", "process": "10.3 View audit evidence", "output": "Filtered audit results", "to": "Authorized audit reviewer", "to_kind": "actor"},
        {"from": "Authorized backup operator", "from_kind": "actor", "input": "Create, import or cleanup choice", "process": "11.1 Check and manage backups", "output": "Validated backup and result", "to": "Backup archives", "to_kind": "store"},
        {"from": "Authorized backup operator", "from_kind": "actor", "input": "Archive, password and confirmation", "process": "11.2 Save recovery copy and restore", "output": "Restored records and private files", "to": "System records and recovery copy", "to_kind": "store"}
      ],
      "note": "Opening a notice does not finish work. Restore replaces live records and files, blocks use during recovery and signs out the operator after success."
    }
  ]
}
