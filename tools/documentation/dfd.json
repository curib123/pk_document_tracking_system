    {
      "id": "decision-transfer",
      "kind": "request-decision-data",
      "approval_example": "approval-transfer",
      "title": "Hardcopy transfer: requests and decisions",
      "summary": "The proposal identifies the hardcopy, receiving user and destination. Approval prepares the handoff; receipt updates custody later.",
