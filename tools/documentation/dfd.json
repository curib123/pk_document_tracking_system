      "approval_example": "approval-access",
      "title": "Document access: requests and decisions",
      "summary": "The proposal names the document and requested expiry. The requester completes the final confirmation before temporary access is granted.",
      "flows": [
        {
          "from": "Requester",
          "from_kind": "actor",
          "input": "Document and access expiry",
          "process": "Submit an access request",
          "output": "Submitted proposal and route",
