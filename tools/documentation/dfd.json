        {"from": "Authorized backup operator", "from_kind": "actor", "input": "Create, import or cleanup choice", "process": "11.1 Check and manage backups", "output": "Validated backup and result", "to": "Backup archives", "to_kind": "store"},
        {"from": "Authorized backup operator", "from_kind": "actor", "input": "Archive, password and confirmation", "process": "11.2 Save recovery copy and restore", "output": "Restored records and private files", "to": "System records and recovery copy", "to_kind": "store"}
