{
  "title": "PK Document Tracking System - Data Flow Diagram",
  "pages": [
    {
      "id": "context-all-roles",
      "kind": "context",
      "title": "People and their information",
      "summary": "See what each of the five standard roles provides to PK DTS and receives in return.",
      "actors": [
        {"role": "Staff", "responsibility": "Requester, holder or named receiving user", "sends": "Searches; requests; receipt", "receives": "Records; status; tasks"},
        {"role": "Document Control Officer", "responsibility": "Controls documents; reviews assigned requests", "sends": "Record changes; decisions", "receives": "Documents; review tasks"},
        {"role": "Plant Manager", "responsibility": "Reviews assigned requests; may also request", "sends": "Decisions; requests", "receives": "Proposals; records; status"},
        {"role": "Administrator", "responsibility": "Manages accounts, setup and recovery", "sends": "Setup; recovery choices", "receives": "Results; records; archives"},
        {"role": "Internal Auditor", "responsibility": "Reviews permitted records and audit evidence", "sends": "Searches; audit filters", "receives": "Records; history; audit"}
      ],
      "note": "These are the five standard roles; custom roles are allowed. Requester, requester's leader and receiving user describe duties, not extra roles."
    },
    {
      "id": "overview",
      "title": "How information moves through PK DTS",
      "summary": "Read each row from left to right: information comes in, an activity takes place, and a result is recorded or shared.",
      "flows": [
        {"from": "User", "from_kind": "actor", "input": "Sign-in details and search terms", "process": "1. Sign in and find records", "output": "Sign-in result; permitted records", "to": "User", "to_kind": "actor"},
        {"from": "Document controller", "from_kind": "actor", "input": "Document details and files", "process": "2-4. Maintain document records", "output": "Saved documents and changes", "to": "Document registers", "to_kind": "store"},
        {"from": "Request participants", "from_kind": "actor", "input": "Proposal, file and decisions", "process": "5. Review document requests", "output": "Request progress and decisions", "to": "Request records", "to_kind": "store"},
        {"from": "Document user", "from_kind": "actor", "input": "Handoff, access or disposal details", "process": "6-8. Track holders and document use", "output": "Holder, access or disposal result", "to": "Document tracking records", "to_kind": "store"},
        {"from": "Authorized setup user", "from_kind": "actor", "input": "Setup and recovery choices", "process": "9-11. Manage system settings", "output": "Settings, notices, audit and backups", "to": "System records", "to_kind": "store"}
      ],
      "note": "Boxes show people or activities. Open-ended boxes show saved records. Arrow labels explain what information moves between them."
    },
    {
      "id": "hardcopy-tracking",
      "title": "2. Physical documents and storage",
      "summary": "Register and edit hardcopies directly. New hardcopy creation and update requests are unavailable.",
      "flows": [
        {"from": "Hardcopy record editor", "from_kind": "actor", "input": "Title, holder and storage", "process": "2.1 Register or edit hardcopy", "output": "Record and change history", "to": "Hardcopy register", "to_kind": "store"},
        {"from": "Reference records", "from_kind": "store", "input": "Active storage choices and holder", "process": "2.1 Check record details", "output": "Save result or required correction", "to": "Hardcopy record editor", "to_kind": "actor"},
        {"from": "Hardcopy register", "from_kind": "store", "input": "Holder, storage and status", "process": "2.2 View hardcopy details", "output": "Holder and storage details", "to": "Authorized document user", "to_kind": "actor"},
        {"from": "Hardcopy register", "from_kind": "store", "input": "Retention start and end dates", "process": "2.3 View retention status", "output": "Days remaining; due; overdue", "to": "Authorized record reviewer", "to_kind": "actor"},
        {"from": "Handoff records", "from_kind": "store", "input": "Approved move and receipt history", "process": "2.2 View tracking history", "output": "Release and receipt details", "to": "Authorized reviewer", "to_kind": "actor"}
      ],
      "note": "Storage follows Area > Specific > optional Asset > Location. Retention dates remind you to review a document; they never dispose of it."
    },
    {
      "id": "softcopy-files",
      "title": "3. Softcopy documents and files",
      "summary": "Direct changes take effect immediately. Requested changes take effect after final approval. Softcopy cancellation is unavailable.",
      "flows": [
        {"from": "Document controller", "from_kind": "actor", "input": "Title, category, pages and file", "process": "3.1 Create or revise directly", "output": "Current document and file", "to": "Softcopy records", "to_kind": "store"},
        {"from": "Requester", "from_kind": "actor", "input": "Proposed details and file", "process": "5. Save and route request", "output": "Draft or submitted proposal", "to": "Request records", "to_kind": "store"},
        {"from": "Request records", "from_kind": "store", "input": "Approved creation or revision", "process": "3.2 Publish approved change", "output": "Current revision and file", "to": "Softcopy records", "to_kind": "store"},
        {"from": "Softcopy records", "from_kind": "store", "input": "Current file and user access", "process": "3.3 Check file permission", "output": "Download or print access", "to": "Authorized file user", "to_kind": "actor"},
        {"from": "Softcopy revision history", "from_kind": "store", "input": "Revision details and changes", "process": "3.4 View revision history", "output": "Earlier revisions and changes", "to": "Authorized reviewer", "to_kind": "actor"}
      ],
      "note": "New records use Softcopy Categories and automatic numbers; a series is optional. A revision keeps the same document number and adds a revision."
    },
    {
      "id": "external-documents",
      "title": "4. External documents and files",
      "summary": "Documents from outside the organization use their own categories. Create or revise them directly, or request approval.",
      "flows": [
        {"from": "Document controller", "from_kind": "actor", "input": "Title, category, description and file", "process": "4.1 Create or revise directly", "output": "Current document and revision", "to": "External document records", "to_kind": "store"},
        {"from": "Requester", "from_kind": "actor", "input": "Creation or revision proposal", "process": "5. Save and route request", "output": "Proposal and file for review", "to": "Request records", "to_kind": "store"},
        {"from": "Request records", "from_kind": "store", "input": "Approved creation or revision", "process": "4.2 Publish approved change", "output": "Current document and file", "to": "External document records", "to_kind": "store"},
        {"from": "External Categories", "from_kind": "store", "input": "Category and parent folder", "process": "4.3 Browse external folders", "output": "Permitted document list", "to": "Authorized document user", "to_kind": "actor"},
        {"from": "External document records", "from_kind": "store", "input": "Current file and user access", "process": "4.4 Check file permission", "output": "Current file download", "to": "Authorized file user", "to_kind": "actor"}
      ],
      "note": "Create and revise both need a new attachment. Revision numbers increase automatically. External documents have no retention dates; Download opens the current file."
    },
    {
      "id": "requests-approvals",
      "title": "5. Requests and approval decisions",
      "summary": "The published approval route sets who reviews a request and in what order. PK DTS saves each decision.",
      "flows": [
        {"from": "Requester", "from_kind": "actor", "input": "Draft details, file and submission", "process": "5.1 Check and submit request", "output": "Submitted request and route", "to": "Request records", "to_kind": "store"},
        {"from": "Published approval routes", "from_kind": "store", "input": "Review order and requester's leader", "process": "5.2 Assign the active review", "output": "Proposal, review task and file", "to": "Assigned approver", "to_kind": "actor"},
        {"from": "Assigned approver", "from_kind": "actor", "input": "Approve, Return or Reject; remarks", "process": "5.3 Record the decision", "output": "Decision and current stage", "to": "Request records", "to_kind": "store"},
        {"from": "Request records", "from_kind": "store", "input": "First reviewer returns the request", "process": "5.4 Show required corrections", "output": "Request to correct and resubmit", "to": "Requester", "to_kind": "actor"},
        {"from": "Request records", "from_kind": "store", "input": "Final approval and request details", "process": "5.5 Apply approved action", "output": "Document change or pending handoff", "to": "Document activity records", "to_kind": "store"}
      ],
      "note": "A later Return sends work to the previous approver. Reject ends the request. Resubmission keeps the route. Reading a notice makes no decision."
    },
    {
      "id": "decision-softcopy-create",
      "kind": "request-decision-data",
      "approval_example": "approval-return-reject",
      "title": "Softcopy creation: requests and decisions",
      "summary": "A new softcopy proposal and its file pass through the supplied default reviewers. Each decision updates the request.",
      "flows": [
        {
          "from": "Requester",
          "from_kind": "actor",
          "input": "New document details and file",
          "process": "Submit a creation request",
          "output": "Submitted proposal and route",
          "to": "Request records",
          "to_kind": "store"
        },
        {
          "from": "Request records",
          "from_kind": "store",
          "input": "Proposal and current review",
          "process": "Assign the active review",
          "output": "Review task and request details",
          "to": "Assigned reviewer",
          "to_kind": "actor"
        },
        {
          "from": "Assigned reviewer",
          "from_kind": "actor",
          "input": "Approve decision and remarks",
          "process": "Record approval and progress",
          "output": "Next review or new softcopy",
          "to": "Request and softcopy records",
          "to_kind": "store"
        },
        {
          "from": "Assigned reviewer",
          "from_kind": "actor",
          "input": "Return decision and remarks",
          "process": "Record the return destination",
          "output": "Correction or earlier review",
          "to": "Requester or prior reviewer",
          "to_kind": "actor"
        },
        {
          "from": "Assigned reviewer",
          "from_kind": "actor",
          "input": "Reject decision and remarks",
          "process": "Record rejection and close",
          "output": "Rejected; no document created",
          "to": "Request decision history",
          "to_kind": "store"
        }
      ],
      "note": "Final approval creates the Active softcopy and approved file at revision 00; the request becomes Completed. Reject creates no document."
    },
    {
      "id": "decision-softcopy-revise",
      "kind": "request-decision-data",
      "approval_example": "approval-softcopy-revise",
      "title": "Softcopy revision: requests and decisions",
      "summary": "A revision proposal identifies the existing softcopy and replacement file. Review decisions control when that file becomes current.",
      "flows": [
        {
          "from": "Requester",
          "from_kind": "actor",
          "input": "Revision details and new file",
          "process": "Submit a revision request",
          "output": "Submitted proposal and route",
          "to": "Request records",
          "to_kind": "store"
        },
        {
          "from": "Request records",
          "from_kind": "store",
          "input": "Proposal and current review",
          "process": "Assign the active review",
          "output": "Review task and request details",
          "to": "Assigned reviewer",
          "to_kind": "actor"
        },
        {
          "from": "Assigned reviewer",
          "from_kind": "actor",
          "input": "Approve decision and remarks",
          "process": "Record approval and progress",
          "output": "Next review or approved revision",
          "to": "Request and softcopy records",
          "to_kind": "store"
        },
        {
          "from": "Assigned reviewer",
          "from_kind": "actor",
          "input": "Return decision and remarks",
          "process": "Record the return destination",
          "output": "Correction or earlier review",
          "to": "Requester or prior reviewer",
          "to_kind": "actor"
        },
        {
          "from": "Assigned reviewer",
          "from_kind": "actor",
          "input": "Reject decision and remarks",
          "process": "Record rejection and close",
          "output": "Rejected; no new revision",
          "to": "Request decision history",
          "to_kind": "store"
        }
      ],
      "note": "Final approval advances the revision and publishes the replacement file; the request becomes Completed. Reject leaves the current file unchanged."
    },
