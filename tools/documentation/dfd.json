        },
        {
          "from": "Request records",
          "from_kind": "store",
          "input": "Proposal and current review",
          "process": "Assign the active review",
          "output": "Review task and request details",
          "to": "Assigned reviewer",
          "to_kind": "actor"
        },
        {
          "from": "Assigned reviewer",
          "from_kind": "actor",
          "input": "Approve decision and remarks",
          "process": "Record approval and progress",
          "output": "Next review or approved handoff",
          "to": "Request and transfer records",
          "to_kind": "store"
        },
        {
          "from": "Assigned reviewer",
          "from_kind": "actor",
          "input": "Return decision and remarks",
          "process": "Record the return destination",
          "output": "Correction or earlier review",
