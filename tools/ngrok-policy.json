{
  "on_http_request": [
    {
      "expressions": [
        "req.url.path == '/' || req.url.path == '/pk_document_tracking_system'"
      ],
      "actions": [
        {
          "type": "redirect",
          "config": {
            "from": "^https?://[^/]+(?:/|/pk_document_tracking_system)(?:\\?.*)?$",
            "to": "https://${req.url.authority}/pk_document_tracking_system/",
            "status_code": 302
          }
        }
      ]
    },
    {
      "expressions": [
        "!req.url.path.startsWith('/pk_document_tracking_system/') || req.url.path.contains('%') || req.url.path.contains('..') || req.url.path.contains('\\\\')"
      ],
      "actions": [
        {
          "type": "custom-response",
          "config": {
            "status_code": 404,
            "body": "Not found",
            "headers": {
              "content-type": "text/plain; charset=utf-8"
            }
          }
        }
      ]
    }
  ]
}
