Margin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>Published versions are read-only. Use Create Next Draft, or</Text></Shape><Shape ID="51" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>7.450349595811632</PinX><PinY>1.4217686123318143</PinY><Width>3.2062547471788196</Width><Height>0.31752777099609375</Height><LocPinX>1.6031273735894098</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>Start First Draft when no version exists.</Text></Shape><Shape ID="52" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>13.245942009819878</PinX><PinY>1.6884583367241754</PinY><Width>4.741884019639757</Width><Height>0.31752777099609375</Height><LocPinX>2.3709420098198786</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>Only one draft per workflow is available. The request types</Text></Shape><Shape ID="53" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>13.23122829861111</PinX><PinY>1.4217686123318143</PinY><Width>4.712456597222222</Width><Height>0.31752777099609375</Height><LocPinX>2.356228298611111</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>are predefined; configuring a route does not enable retired</Text></Shape><Shape ID="54" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>11.469813876681858</PinX><PinY>1.1550788879394531</PinY><Width>1.1896277533637152</Width><Height>0.31752777099609375</Height><LocPinX>0.5948138766818576</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>request types.</Text></Shape></Shapes></Page><Page ID="29" NameU="Page-30" Name="Follow task and retention reminders"><PageSheet LineStyle="0" FillStyle="0" TextStyle="0"><PageProps><PageWidth Unit="IN">16.52777777777778</PageWidth><PageHeight Unit="IN">11.694444444444445</PageHeight><PageScale Unit="IN">1</PageScale><DrawingScale Unit="IN">1</DrawingScale></PageProps><PrintProps><PrintPageOrientation>2</PrintPageOrientation></PrintProps></PageSheet><Shapes><Shape ID="1" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>8.26388888888889</PinX><PinY>11.659722222222221</PinY><Width>16.52777777777778</Width><Height>0.06944444444444445</Height><LocPinX>8.26388888888889</LocPinX><LocPinY>0.034722222222222224</