TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>Plant Manager, Internal Auditor and Staff. Custom roles can</Text></Shape><Shape ID="50" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>1.248777601453993</PinX><PinY>1.1550788879394531</PinY><Width>0.8586663140190972</Width><Height>0.31752777099609375</Height><LocPinX>0.4293331570095486</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>be added.</Text></Shape><Shape ID="51" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>7.977211422390408</PinX><PinY>1.6884583367241754</PinY><Width>4.259978400336371</Width><Height>0.31752777099609375</Height><LocPinX>2.1299892001681857</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>Administrator privileges are fixed. Other roles can be</Text></Shape><Shape ID="52" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>8.16824001736111</PinX><PinY>1.4217686123318143</PinY><Width>4.642035590277778</Width><Height>0.31752777099609375</Height><LocPinX>2.321017795138889</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>configured; an administrator cannot delegate actions they</Text></Shape><Shape ID="53" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>6.060611089070638</PinX><PinY>1.1550788879394531</PinY><Width>0.4267777336968316</Width><Height>0.31752777099609375</Height><LocPinX>0.2133888668484158</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>lack.</Text></Shape><Shape ID="54" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0"><XForm><PinX>13.246123419867622</PinX><PinY>1.6884583367241754</PinY><Width>4.742246839735243</Width><Height>0.31752777099609375</Height><LocPinX>2.3711234198676214</LocPinX><LocPinY>0.15876388549804688</LocPinY></XForm><Fill><FillPattern>0</FillPattern></Fill><Line><LinePattern>0</LinePattern></Line><TextBlock><LeftMargin>0</LeftMargin><RightMargin>0</RightMargin><TopMargin>0</TopMargin><BottomMargin>0</BottomMargin><VerticalAlign>0</VerticalAlign></TextBlock><Char IX="0"><Font>0</Font><Size>0.18055555555555555</Size><Style>0</Style><Color>#1C2B3D</Color></Char><Para IX="0"><HorzAlign>0</HorzAlign></Para><Text>A role cannot be deactivated or removed while assigned to</Tex